# Postgres connection string (server only)
DATABASE_URL=
# Long random string used to sign login tokens
SESSION_SECRET=
# Optional: passwords for the demo accounts created on first start (defaults are in README)
SEED_ADMIN_PASSWORD=
SEED_LIBRARIAN_PASSWORD=
# Optional circulation rules (defaults: 14 days, 2 renewals, 0.50 per day, 5 books per member)
LOAN_DAYS=
MAX_RENEWALS=
FINE_PER_DAY=
MAX_ACTIVE_LOANS=
# Optional: API port (default 3001)
API_PORT=
